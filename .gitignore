# Only these source and documentation directories belong in this repository.
/*
!/.gitignore
!/README.md
!/LICENSE
!/Package.swift
!/Sources/
!/Tests/
!/scripts/
!/assets/
!/.githooks/

# Build products, installers, archives and local development state.
**/.DS_Store
**/.build/
**/.swiftpm/
**/*.app/
**/*.zip
**/*.dmg
**/*.pkg
**/*.tar
**/*.gz
**/*.xcarchive/
**/*.dSYM/
**/__pycache__/
**/*.pyc
**/*.log
**/*.tmp
**/*.bak
**/*.sqlite*
**/*.db
**/*.jsonl

# Runtime credentials, account registries, caches and signing material.
**/auth.json*
**/accounts.json*
**/settings.json*
**/usage-cache.json*
**/subscription-cache.json*
**/credential-operation/
**/pending-login
**/.env
**/.env.*
**/*.keychain*
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/*.mobileprovision
**/id_rsa*
**/id_ed25519*
